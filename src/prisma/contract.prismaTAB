datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Facility {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        String?
  city        String?
  state       String?
  timezone    String   @default("America/Los_Angeles")
  status      String   @default("ACTIVE")

  users       User[]
  assets      Asset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String   @unique
  role        UserRole
  department  String?
  status      UserStatus @default(ACTIVE)

  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([role])
}

model Asset {
  id              String      @id @default(uuid())
  assetCode       String
  name            String
  category        String
  location        String?
  manufacturer    String?
  model           String?
  serialNumber    String?
  externalCmmsId  String?
  status          AssetStatus @default(ACTIVE)

  facilityId      String
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([facilityId, assetCode])
  @@index([facilityId])
  @@index([category])
  @@index([externalCmmsId])
}

enum UserRole {
  ENGINEER
  FACILITIES_MANAGER
  COMPLIANCE
  ADMINISTRATOR
  SURVEYOR_READ_ONLY
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  OUT_OF_SERVICE
  RETIRED
}



